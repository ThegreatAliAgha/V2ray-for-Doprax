//@version=5
indicator("Accumulation Manipulation Distribution (AMD Model)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ════════════════════════════════════════════════════════════════════════════
// INPUT PARAMETERS
// ════════════════════════════════════════════════════════════════════════════

atrMultiplier = input.float(0.5, "ATR Compression Multiplier", minval=0.1, maxval=1.0, step=0.1, group="Accumulation Settings")
minBarCount = input.int(10, "Minimum Bar Count in Box", minval=5, maxval=50, group="Accumulation Settings")
rangePercent = input.float(0.25, "Max Range % of Price", minval=0.05, maxval=1.0, step=0.05, group="Accumulation Settings")
volumeThreshold = input.float(1.0, "Volume Threshold Multiplier", minval=0.5, maxval=3.0, step=0.1, group="Accumulation Settings")
smallBodyPercent = input.float(60.0, "Min % Small Body Candles", minval=40.0, maxval=90.0, step=5.0, group="Accumulation Settings")
minTouches = input.int(2, "Min Touches per Boundary", minval=1, maxval=5, group="Accumulation Settings")

showManipulation = input.bool(true, "Show Manipulation Labels", group="Visual Settings")
showDistribution = input.bool(true, "Show Distribution Labels", group="Visual Settings")
showPOC = input.bool(true, "Show POC Line", group="Visual Settings")
showBoxes = input.bool(true, "Show Accumulation Boxes", group="Visual Settings")

enableAlerts = input.bool(true, "Enable Alerts", group="Alert Settings")

// ════════════════════════════════════════════════════════════════════════════
// GLOBAL VARIABLES AND ARRAYS
// ════════════════════════════════════════════════════════════════════════════

var box activeBox = na
var line pocLine = na
var float boxTop = na
var float boxBottom = na
var int boxStartBar = na
var int boxEndBar = na
var bool boxActive = false
var float[] pricesInBox = array.new_float()
var float[] volumesInBox = array.new_float()
var int topTouches = 0
var int bottomTouches = 0
var bool manipulationDetected = false
var bool distributionConfirmed = false
var int confirmationCount = 0
var float breakoutDirection = 0.0
var int breakoutStartBar = 0
var bool waitingConfirmation = false

// ════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════

// Calculate ATR
atr20 = ta.atr(20)

// Calculate average volume
avgVolume = ta.sma(volume, 20)

// Check if candle has small body (body < 40% of total range)
isSmallBody() =>
    bodySize = math.abs(close - open)
    totalRange = high - low
    totalRange > 0 ? (bodySize / totalRange) < 0.4 : false

// Calculate historical average ATR (excluding current compression zone)
getHistoricalATR(lookback) =>
    sum = 0.0
    count = 0
    for i = 0 to lookback - 1
        sum := sum + ta.atr(20)[i]
        count := count + 1
    count > 0 ? sum / count : ta.atr(20)

// Check if price is in compression
isInCompression(bars) =>
    if bars < minBarCount
        false
    else
        // Calculate range of last N bars
        highest = ta.highest(high, bars)
        lowest = ta.lowest(low, bars)
        range = highest - lowest
        midPrice = (highest + lowest) / 2
        
        // Check range percentage
        rangePercentActual = (range / midPrice) * 100
        if rangePercentActual > rangePercent
            false
        else
            // Check ATR compression
            currentATR = ta.atr(20)
            historicalATR = getHistoricalATR(50)
            atrCompressed = currentATR <= (historicalATR * atrMultiplier)
            
            // Check small body percentage
            smallBodyCount = 0
            for i = 0 to bars - 1
                bodySize = math.abs(close[i] - open[i])
                totalRange = high[i] - low[i]
                if totalRange > 0 and (bodySize / totalRange) < 0.4
                    smallBodyCount := smallBodyCount + 1
            smallBodyPct = (smallBodyCount / bars) * 100
            
            // Check volume
            avgVol = 0.0
            for i = 0 to bars - 1
                avgVol := avgVol + volume[i]
            avgVol := avgVol / bars
            avgVolOutside = ta.sma(volume, 20)
            volumeCondition = avgVol >= (avgVolOutside * volumeThreshold)
            
            // All conditions must be met
            atrCompressed and smallBodyPct >= smallBodyPercent and volumeCondition

// Count boundary touches
countBoundaryTouches(top, bottom, bars) =>
    topCount = 0
    bottomCount = 0
    touchThreshold = (top - bottom) * 0.02 // 2% threshold
    
    for i = 0 to bars - 1
        if high[i] >= (top - touchThreshold) and high[i] <= top
            topCount := topCount + 1
        if low[i] <= (bottom + touchThreshold) and low[i] >= bottom
            bottomCount := bottomCount + 1
    
    [topCount, bottomCount]

// Calculate POC (Point of Control) using volume-weighted price
calculatePOC(prices, volumes) =>
    if array.size(prices) == 0 or array.size(volumes) == 0
        na
    else
        sumVolumePrice = 0.0
        sumVolume = 0.0
        for i = 0 to array.size(prices) - 1
            price = array.get(prices, i)
            vol = array.get(volumes, i)
            sumVolumePrice := sumVolumePrice + (price * vol)
            sumVolume := sumVolume + vol
        sumVolume > 0 ? sumVolumePrice / sumVolume : na

// ════════════════════════════════════════════════════════════════════════════
// ACCUMULATION DETECTION LOGIC
// ════════════════════════════════════════════════════════════════════════════

var int compressionBars = 0

// Check if we're building a compression zone
if not boxActive
    compressionBars := compressionBars + 1
    
    // Check if compression conditions are met
    if compressionBars >= minBarCount and isInCompression(compressionBars)
        // Calculate box boundaries
        highest = ta.highest(high, compressionBars)
        lowest = ta.lowest(low, compressionBars)
        
        // Count touches
        [topCount, bottomCount] = countBoundaryTouches(highest, lowest, compressionBars)
        
        // If we have enough touches, create the box
        if topCount >= minTouches and bottomCount >= minTouches
            boxActive := true
            boxTop := highest
            boxBottom := lowest
            boxStartBar := bar_index - compressionBars + 1
            boxEndBar := bar_index
            topTouches := topCount
            bottomTouches := bottomCount
            manipulationDetected := false
            distributionConfirmed := false
            confirmationCount := 0
            breakoutDirection := 0.0
            waitingConfirmation := false
            breakoutStartBar := 0
            
            // Store prices and volumes for POC calculation
            array.clear(pricesInBox)
            array.clear(volumesInBox)
            for i = 0 to compressionBars - 1
                avgPrice = (high[i] + low[i] + close[i]) / 3
                array.push(pricesInBox, avgPrice)
                array.push(volumesInBox, volume[i])
            
            // Draw the accumulation box
            if showBoxes
                activeBox := box.new(boxStartBar, boxTop, bar_index + 10, boxBottom, 
                     border_color=color.yellow, bgcolor=color.new(color.yellow, 90), 
                     border_width=2, extend=extend.right, text="ABX", text_color=color.yellow)
            
            // Draw POC line
            if showPOC
                poc = calculatePOC(pricesInBox, volumesInBox)
                if not na(poc)
                    pocLine := line.new(boxStartBar, poc, bar_index + 10, poc, 
                         color=color.red, width=1, style=line.style_dashed, extend=extend.right)
            
            compressionBars := 0
else
    // We have an active box - extend it and check for breakout
    if showBoxes and not na(activeBox)
        box.set_right(activeBox, bar_index + 10)
    
    if showPOC and not na(pocLine)
        line.set_x2(pocLine, bar_index + 10)
    
    // Add current bar data to box
    avgPrice = (high + low + close) / 3
    array.push(pricesInBox, avgPrice)
    array.push(volumesInBox, volume)

// ════════════════════════════════════════════════════════════════════════════
// MANIPULATION DETECTION LOGIC
// ════════════════════════════════════════════════════════════════════════════

if boxActive and not manipulationDetected and not distributionConfirmed
    // Check for fake breakout
    brokeAbove = high > boxTop
    brokeBelow = low < boxBottom
    closedInside = close < boxTop and close > boxBottom
    highVolume = volume > avgVolume
    
    if (brokeAbove or brokeBelow) and closedInside and highVolume
        manipulationDetected := true
        
        if showManipulation
            labelText = "Manipulation"
            labelY = brokeAbove ? high : low
            labelStyle = brokeAbove ? label.style_label_down : label.style_label_up
            label.new(bar_index, labelY, labelText, 
                 color=color.new(color.orange, 20), textcolor=color.white, 
                 style=labelStyle, size=size.small)
        
        if enableAlerts
            alert("AMD Model: Manipulation detected - Fake breakout!", alert.freq_once_per_bar)

// ════════════════════════════════════════════════════════════════════════════
// DISTRIBUTION DETECTION LOGIC
// ════════════════════════════════════════════════════════════════════════════

if boxActive and not distributionConfirmed
    // Check if price closed outside the box
    closedAbove = close > boxTop
    closedBelow = close < boxBottom
    
    if not waitingConfirmation
        // Initial breakout detection
        if closedAbove or closedBelow
            breakoutDirection := closedAbove ? 1.0 : -1.0
            confirmationCount := 1
            breakoutStartBar := bar_index
            waitingConfirmation := true
    else
        // We're in confirmation phase - check next candles
        barsAfterBreakout = bar_index - breakoutStartBar
        
        if barsAfterBreakout <= 3
            // Still within confirmation window
            if breakoutDirection == 1.0 and closedAbove
                confirmationCount := confirmationCount + 1
            else if breakoutDirection == -1.0 and closedBelow
                confirmationCount := confirmationCount + 1
            else if close >= boxBottom and close <= boxTop
                // Price returned inside box, invalidate breakout
                breakoutDirection := 0.0
                confirmationCount := 0
                waitingConfirmation := false
            
            // Check if we have 3 consecutive closes (including the initial breakout)
            if confirmationCount >= 3
                distributionConfirmed := true
                waitingConfirmation := false
                
                if showDistribution
                    labelText = "Distribution"
                    labelY = breakoutDirection > 0 ? high : low
                    labelStyle = breakoutDirection > 0 ? label.style_label_up : label.style_label_down
                    label.new(bar_index, labelY, labelText, 
                         color=color.new(color.red, 20), textcolor=color.white, 
                         style=labelStyle, size=size.normal)
                
                if enableAlerts
                    direction = breakoutDirection > 0 ? "Bullish" : "Bearish"
                    alert("AMD Model: Distribution confirmed - " + direction + " breakout!", alert.freq_once_per_bar)
                
                // End the box
                if showBoxes and not na(activeBox)
                    box.set_right(activeBox, bar_index)
                    box.set_extend(activeBox, extend.none)
                
                if showPOC and not na(pocLine)
                    line.set_x2(pocLine, bar_index)
                    line.set_extend(pocLine, extend.none)
                
                // Reset box state
                boxActive := false
                compressionBars := 0
                breakoutDirection := 0.0
                confirmationCount := 0
        else
            // Confirmation window expired without 3 consecutive closes
            breakoutDirection := 0.0
            confirmationCount := 0
            waitingConfirmation := false

// ════════════════════════════════════════════════════════════════════════════
// ADDITIONAL CHECKS - End box if price action invalidates accumulation
// ════════════════════════════════════════════════════════════════════════════

if boxActive and not distributionConfirmed
    // If box has been active for too long (more than 100 bars), reset
    barsInBox = bar_index - boxStartBar
    if barsInBox > 100
        boxActive := false
        compressionBars := 0
        waitingConfirmation := false
        breakoutDirection := 0.0
        confirmationCount := 0
        
        // Stop extending box and POC
        if showBoxes and not na(activeBox)
            box.set_right(activeBox, bar_index)
            box.set_extend(activeBox, extend.none)
        
        if showPOC and not na(pocLine)
            line.set_x2(pocLine, bar_index)
            line.set_extend(pocLine, extend.none)

// ════════════════════════════════════════════════════════════════════════════
// PLOTTING (for debugging purposes)
// ════════════════════════════════════════════════════════════════════════════

// Plot ATR for reference (optional, can be commented out)
plot(atr20, "ATR(20)", color=color.new(color.blue, 80), display=display.none)

// Plot signals
plotshape(distributionConfirmed and breakoutDirection > 0, "Bullish Distribution", 
     shape.triangleup, location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(distributionConfirmed and breakoutDirection < 0, "Bearish Distribution", 
     shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.tiny)
