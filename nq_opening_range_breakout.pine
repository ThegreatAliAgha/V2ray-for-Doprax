//@version=5
indicator("NQ Opening Range & IB Stats", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// Settings & Inputs
// -----------------------------------------------------------------------------
var string GRP_R1 = "Range 1 Settings"
r1_enabled = input.bool(true, "Enable Range 1", group=GRP_R1)
r1_start_h = input.int(9,  "Start Hour", minval=0, maxval=23, group=GRP_R1)
r1_start_m = input.int(30, "Start Minute", minval=0, maxval=59, group=GRP_R1)
r1_end_h   = input.int(9,  "End Hour", minval=0, maxval=23, group=GRP_R1)
r1_end_m   = input.int(40, "End Minute", minval=0, maxval=59, group=GRP_R1)
r1_target_h = input.int(11, "Target Hour", minval=0, maxval=23, group=GRP_R1)
r1_target_m = input.int(30, "Target Minute", minval=0, maxval=59, group=GRP_R1)
r1_color_box = input.color(color.new(color.gray, 90), "Box Color", group=GRP_R1)
r1_color_bull = input.color(color.green, "Bullish Line Color", group=GRP_R1)
r1_color_bear = input.color(color.red, "Bearish Line Color", group=GRP_R1)

var string GRP_R2 = "Range 2 Settings"
r2_enabled = input.bool(true, "Enable Range 2", group=GRP_R2)
r2_start_h = input.int(9,  "Start Hour", minval=0, maxval=23, group=GRP_R2)
r2_start_m = input.int(30, "Start Minute", minval=0, maxval=59, group=GRP_R2)
r2_end_h   = input.int(9,  "End Hour", minval=0, maxval=23, group=GRP_R2)
r2_end_m   = input.int(45, "End Minute", minval=0, maxval=59, group=GRP_R2)
r2_target_h = input.int(11, "Target Hour", minval=0, maxval=23, group=GRP_R2)
r2_target_m = input.int(30, "Target Minute", minval=0, maxval=59, group=GRP_R2)
r2_color_box = input.color(color.new(color.blue, 95), "Box Color", group=GRP_R2)
r2_color_bull = input.color(color.green, "Bullish Line Color", group=GRP_R2)
r2_color_bear = input.color(color.red, "Bearish Line Color", group=GRP_R2)

var string GRP_R3 = "Range 3 Settings"
r3_enabled = input.bool(true, "Enable Range 3", group=GRP_R3)
r3_start_h = input.int(9,  "Start Hour", minval=0, maxval=23, group=GRP_R3)
r3_start_m = input.int(30, "Start Minute", minval=0, maxval=59, group=GRP_R3)
r3_end_h   = input.int(10, "End Hour", minval=0, maxval=23, group=GRP_R3)
r3_end_m   = input.int(0,  "End Minute", minval=0, maxval=59, group=GRP_R3)
r3_target_h = input.int(14, "Target Hour", minval=0, maxval=23, group=GRP_R3)
r3_target_m = input.int(0,  "Target Minute", minval=0, maxval=59, group=GRP_R3)
r3_color_box = input.color(color.new(color.orange, 90), "Box Color", group=GRP_R3)
r3_color_bull = input.color(color.green, "Bullish Line Color", group=GRP_R3)
r3_color_bear = input.color(color.red, "Bearish Line Color", group=GRP_R3)

// -----------------------------------------------------------------------------
// Functions
// -----------------------------------------------------------------------------

// Helper to check if a specific NY time is reached or passed within the same day
is_time_at_or_after(h, m) =>
    int ny_h = hour(time, "America/New_York")
    int ny_m = minute(time, "America/New_York")
    (ny_h * 60 + ny_m) >= (h * 60 + m)

is_time_before(h, m) =>
    int ny_h = hour(time, "America/New_York")
    int ny_m = minute(time, "America/New_York")
    (ny_h * 60 + ny_m) < (h * 60 + m)

get_val_in_range(start_h, start_m, end_h, end_m) =>
    int ny_h = hour(time, "America/New_York")
    int ny_m = minute(time, "America/New_York")
    int current_mins = ny_h * 60 + ny_m
    int start_mins = start_h * 60 + start_m
    int end_mins = end_h * 60 + end_m
    current_mins >= start_mins and current_mins < end_mins

// Helper for status text
get_status_text(s) =>
    if s == 0
        "Waiting"
    else if s == 1
        "Bullish Breakout"
    else if s == 2
        "Bearish Breakout"
    else if s == 3
        "Success"
    else if s == 4
        "Failed"
    else
        "Unknown"

get_status_color(s) =>
    if s == 0
        color.gray
    else if s == 1 or s == 3
        color.green
    else if s == 2 or s == 4
        color.red
    else
        color.gray

// -----------------------------------------------------------------------------
// State Management
// -----------------------------------------------------------------------------

// We need to track High/Low for each range
var float or10_high = na
var float or10_low  = na
var float or15_high = na
var float or15_low  = na
var float or30_high = na
var float or30_low  = na
var float ib_high   = na
var float ib_low    = na
var float ib_open   = na

// State tracking for breakouts
// 0 = Waiting, 1 = Bullish Breakout, 2 = Bearish Breakout, 3 = Finished/Safe, 4 = Failed
var int state_10 = 0
var int state_15 = 0
var int state_30 = 0

// Track if we have drawn for today to avoid repainting/duplicates
var bool or10_drawn = false
var bool or15_drawn = false
var bool or30_drawn = false
var bool ib_drawn   = false

// Statistics
var int wins_10 = 0
var int total_10 = 0
var int wins_15 = 0
var int total_15 = 0
var int wins_30 = 0
var int total_30 = 0

// Reset variables at the start of a new trading day
// We detect new day by change in dayofweek/dayofmonth
is_new_day = ta.change(time("D"))
if is_new_day
    or10_high := na // Set to na initially, will be set to High/Low on first valid bar
    or10_low  := na
    or15_high := na
    or15_low  := na
    or30_high := na
    or30_low  := na
    ib_high   := high // Keeping IB hardcoded to 09:30 start logic as per original request, or reset
    ib_low    := low
    ib_open   := open

    state_10 := 0
    state_15 := 0
    state_30 := 0

    or10_drawn := false
    or15_drawn := false
    or30_drawn := false
    ib_drawn   := false

// -----------------------------------------------------------------------------
// Logic: Update Ranges
// -----------------------------------------------------------------------------

// We update ranges if current time is >= Start and < End
// Range 1
if r1_enabled and get_val_in_range(r1_start_h, r1_start_m, r1_end_h, r1_end_m)
    or10_high := na(or10_high) ? high : math.max(or10_high, high)
    or10_low  := na(or10_low) ? low : math.min(or10_low, low)

// Range 2
if r2_enabled and get_val_in_range(r2_start_h, r2_start_m, r2_end_h, r2_end_m)
    or15_high := na(or15_high) ? high : math.max(or15_high, high)
    or15_low  := na(or15_low) ? low : math.min(or15_low, low)

// Range 3
if r3_enabled and get_val_in_range(r3_start_h, r3_start_m, r3_end_h, r3_end_m)
    or30_high := na(or30_high) ? high : math.max(or30_high, high)
    or30_low  := na(or30_low) ? low : math.min(or30_low, low)

// IB (09:30 - 10:30) - Keeping this hardcoded for now as it's a specific concept,
// or we could assume it starts at 09:30 always.
if is_time_at_or_after(9, 30) and is_time_before(10, 30)
    // Need to handle reset carefully if IB starts mid-day, but 09:30 is standard.
    // If it's a new day, we already reset.
    // Just ensure we capture proper high/low.
    ib_high := na(ib_high) ? high : math.max(ib_high, high)
    ib_low  := na(ib_low) ? low : math.min(ib_low, low)
    if is_new_day // Reset open if it's the very first bar of day (likely 09:30)
        ib_open := open
    // If our chart starts before 09:30, we need to capture open at 09:30
    if hour(time, "America/New_York") == 9 and minute(time, "America/New_York") == 30
        ib_open := open


// -----------------------------------------------------------------------------
// Logic: Initial Balance Display (at 10:30 Close)
// -----------------------------------------------------------------------------
if not ib_drawn and is_time_at_or_after(10, 30)
    // Simple IB logic
    float final_ib_close = close[1]

    // Draw logic
    if final_ib_close > ib_open
        label.new(bar_index, ib_high, "Stats: 70% Chance Bullish Close", style=label.style_label_down, color=color.green, textcolor=color.white)
    else
        label.new(bar_index, ib_low, "Stats: 67% Chance Bearish Close", style=label.style_label_up, color=color.red, textcolor=color.white)

    ib_drawn := true


// -----------------------------------------------------------------------------
// Logic: Breakout & Validation
// -----------------------------------------------------------------------------

// Helper to process range logic
process_range(high_lvl, low_lvl, state, current_wins, current_total, target_h, target_m, range_name, start_h, start_m, end_h, end_m, enabled, c_box, c_bull, c_bear) =>
    int s = state
    int w = current_wins
    int t = current_total

    if not enabled
        [s, w, t] // Return unchanged if disabled
    else
        // 1. Check for Breakout if Waiting (0)
        // Must be AFTER the range formation is done.
        bool range_formed = is_time_at_or_after(end_h, end_m)

        // Target time timestamp
        bool target_reached = is_time_at_or_after(target_h, target_m)

        if s == 0 and range_formed and not target_reached
            if close > high_lvl
                s := 1 // Bullish Breakout
                t := t + 1
                int target_ts = timestamp("America/New_York", year(time), month(time), dayofmonth(time), target_h, target_m, 0)
                line.new(bar_index, low_lvl, bar_index + 10, low_lvl, xloc=xloc.bar_index, color=c_bull, style=line.style_dashed, width=2)
                line.new(time, low_lvl, target_ts, low_lvl, xloc=xloc.bar_time, color=c_bull, style=line.style_solid, width=2)

            else if close < low_lvl
                s := 2 // Bearish Breakout
                t := t + 1
                int target_ts = timestamp("America/New_York", year(time), month(time), dayofmonth(time), target_h, target_m, 0)
                line.new(time, high_lvl, target_ts, high_lvl, xloc=xloc.bar_time, color=c_bear, style=line.style_solid, width=2)

        // 2. Monitor Active Breakout (1 or 2)
        else if (s == 1 or s == 2) and not target_reached
            if s == 1 and low < low_lvl
                s := 4 // Failed
                label.new(bar_index, low, range_name + " Fail", style=label.style_label_up, color=color.orange, size=size.small)
            else if s == 2 and high > high_lvl
                s := 4 // Failed
                label.new(bar_index, high, range_name + " Fail", style=label.style_label_down, color=color.orange, size=size.small)

        // 3. Check Success at Target Time
        else if (s == 1 or s == 2) and target_reached
            s := 3 // Finished/Win
            w := w + 1
            label.new(bar_index, close, range_name + " Success", style=label.style_label_center, color=color.blue, size=size.small)

        [s, w, t]


// Execute Logic
// Passed variables instead of hardcoded values
[s10, w10, t10] = process_range(or10_high, or10_low, state_10, wins_10, total_10, r1_target_h, r1_target_m, "R1", r1_start_h, r1_start_m, r1_end_h, r1_end_m, r1_enabled, r1_color_box, r1_color_bull, r1_color_bear)
state_10 := s10
wins_10  := w10
total_10 := t10

[s15, w15, t15] = process_range(or15_high, or15_low, state_15, wins_15, total_15, r2_target_h, r2_target_m, "R2", r2_start_h, r2_start_m, r2_end_h, r2_end_m, r2_enabled, r2_color_box, r2_color_bull, r2_color_bear)
state_15 := s15
wins_15  := w15
total_15 := t15

[s30, w30, t30] = process_range(or30_high, or30_low, state_30, wins_30, total_30, r3_target_h, r3_target_m, "R3", r3_start_h, r3_start_m, r3_end_h, r3_end_m, r3_enabled, r3_color_box, r3_color_bull, r3_color_bear)
state_30 := s30
wins_30  := w30
total_30 := t30


// -----------------------------------------------------------------------------
// Visuals: Range Boxes (Optional but helpful)
// -----------------------------------------------------------------------------
// Helper to draw boxes
draw_range_box(drawn, enabled, end_h, end_m, start_h, start_m, high_v, low_v, c_box) =>
    bool d = drawn
    if enabled and is_time_at_or_after(end_h, end_m) and not d
        // Calculate start time in millis.
        // Diff in minutes
        int diff_min = (end_h * 60 + end_m) - (start_h * 60 + start_m)
        box.new(time - (diff_min * 60 * 1000), high_v, time, low_v, xloc=xloc.bar_time, border_color=color.gray, border_style=line.style_dotted, bgcolor=c_box)
        d := true
    d

or10_drawn := draw_range_box(or10_drawn, r1_enabled, r1_end_h, r1_end_m, r1_start_h, r1_start_m, or10_high, or10_low, r1_color_box)
or15_drawn := draw_range_box(or15_drawn, r2_enabled, r2_end_h, r2_end_m, r2_start_h, r2_start_m, or15_high, or15_low, r2_color_box)
or30_drawn := draw_range_box(or30_drawn, r3_enabled, r3_end_h, r3_end_m, r3_start_h, r3_start_m, or30_high, or30_low, r3_color_box)


// -----------------------------------------------------------------------------
// Dashboard
// -----------------------------------------------------------------------------
var table dash = table.new(position.bottom_right, 4, 4, bgcolor=color.new(color.black, 50), frame_color=color.white, frame_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "Range", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Status", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 0, "Win Rate", text_color=color.white, text_size=size.small)
    table.cell(dash, 3, 0, "Count", text_color=color.white, text_size=size.small)

    // 10m Row
    if r1_enabled
        table.cell(dash, 0, 1, "R1", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 1, get_status_text(state_10), text_color=get_status_color(state_10), text_size=size.small)
        float wr10 = total_10 > 0 ? (wins_10 / total_10) * 100 : 0
        table.cell(dash, 2, 1, str.tostring(wr10, "#.##") + "%", text_color=color.white, text_size=size.small)
        table.cell(dash, 3, 1, str.tostring(wins_10) + "/" + str.tostring(total_10), text_color=color.white, text_size=size.small)
    else
        table.cell(dash, 0, 1, "R1 (Off)", text_color=color.gray, text_size=size.small)

    // 15m Row
    if r2_enabled
        table.cell(dash, 0, 2, "R2", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 2, get_status_text(state_15), text_color=get_status_color(state_15), text_size=size.small)
        float wr15 = total_15 > 0 ? (wins_15 / total_15) * 100 : 0
        table.cell(dash, 2, 2, str.tostring(wr15, "#.##") + "%", text_color=color.white, text_size=size.small)
        table.cell(dash, 3, 2, str.tostring(wins_15) + "/" + str.tostring(total_15), text_color=color.white, text_size=size.small)
    else
        table.cell(dash, 0, 2, "R2 (Off)", text_color=color.gray, text_size=size.small)

    // 30m Row
    if r3_enabled
        table.cell(dash, 0, 3, "R3", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 3, get_status_text(state_30), text_color=get_status_color(state_30), text_size=size.small)
        float wr30 = total_30 > 0 ? (wins_30 / total_30) * 100 : 0
        table.cell(dash, 2, 3, str.tostring(wr30, "#.##") + "%", text_color=color.white, text_size=size.small)
        table.cell(dash, 3, 3, str.tostring(wins_30) + "/" + str.tostring(total_30), text_color=color.white, text_size=size.small)
    else
        table.cell(dash, 0, 3, "R3 (Off)", text_color=color.gray, text_size=size.small)
